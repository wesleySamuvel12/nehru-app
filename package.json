{
  "name": "nehru-app",
  "version": "1.0.0",
  "private": true,
  "description": "Nehru International School ERP - Enterprise Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:backend": "pnpm --filter @school-erp/backend start:dev",
    "dev:admin": "pnpm --filter @school-erp/admin-web dev",
    "dev:teacher": "pnpm --filter @school-erp/teacher-web dev",
    "dev:student": "pnpm --filter @school-erp/student-web dev",
    "dev:parent": "pnpm --filter @school-erp/parent-web dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --parallel --filter \"./apps/*\" build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @school-erp/backend db:generate",
    "db:push": "pnpm --filter @school-erp/backend db:push",
    "db:migrate": "pnpm --filter @school-erp/backend db:migrate",
    "db:seed": "pnpm --filter @school-erp/backend db:seed",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0"
}