# ==============================================================================
# Nehru App / School ERP - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and adjust variables for your local development setup:
#   cp .env.example .env
#
# IMPORTANT:
# - Never commit real secrets or credentials to version control.
# - Keep .env in .gitignore.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME="Nehru International School ERP"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Active Database Configuration
# ------------------------------------------------------------------------------
# Active Database Configuration (PostgreSQL via Docker)
# ------------------------------------------------------------------------------
# PostgreSQL connection string (host port 5433 binds to container port 5432):
DATABASE_URL="postgresql://nehru_erp:nehru_erp_dev_secret_change_in_prod@localhost:5433/nehru_erp?schema=public"

# Optional SQLite fallback configuration:
# DATABASE_URL="file:../db/custom.db"

# Docker PostgreSQL environment variables (used by docker-compose.yml):
POSTGRES_USER=nehru_erp
POSTGRES_PASSWORD=nehru_erp_dev_secret_change_in_prod
POSTGRES_DB=nehru_erp
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Secret used for signing JWT session tokens with jose.
# Generate a strong key in production (e.g. `openssl rand -base64 32`).
AUTH_SECRET="change-this-to-a-strong-random-secret-at-least-32-characters"
SESSION_COOKIE="erp_session"
