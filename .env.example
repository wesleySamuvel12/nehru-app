# Global Environment Configuration
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_erp?schema=public"

# Redis Cache & Queues
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# JWT Secrets
JWT_SECRET="super-secret-jwt-token-key-for-school-erp-2026"
JWT_EXPIRATION="7d"
REFRESH_TOKEN_SECRET="super-secret-refresh-key-2026"

# Service Ports
BACKEND_PORT=4000
ADMIN_WEB_PORT=3000
TEACHER_WEB_PORT=3001
STUDENT_WEB_PORT=3002
PARENT_WEB_PORT=3003

# Public URLs
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3000"
NEXT_PUBLIC_TEACHER_URL="http://localhost:3001"
NEXT_PUBLIC_STUDENT_URL="http://localhost:3002"
NEXT_PUBLIC_PARENT_URL="http://localhost:3003"
